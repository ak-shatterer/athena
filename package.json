{
  "name": "athena",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "pipeline": "pnpm --filter @athena/pipeline cli",
    "web": "pnpm --filter @athena/web dev",
    "studio": "pnpm --filter @athena/video studio",
    "typecheck": "turbo run typecheck",
    "db:generate": "pnpm --filter @athena/db generate"
  },
  "devDependencies": {
    "turbo": "^2.3.0",
    "typescript": "^5.7.0",
    "tsx": "^4.19.0",
    "@types/node": "^22.10.0"
  }
}
