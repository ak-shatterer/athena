# Copy to .env. Everything is optional for local use; fill in sections as you deploy.

# --- LLM (the only paid service; Haiku by default) ---
LLM_MODE=live                    # "offline": no API calls, requests/responses as files in out/llm/
ANTHROPIC_API_KEY=
DAILY_TOKEN_BUDGET=400000        # pipeline stops if a day's run exceeds this

# --- Database: leave empty for the local PGlite file in .data/ ---
DATABASE_URL=                    # Supabase → Connect → Transaction pooler URI (port 6543)

# --- Web app login (deployed app only; empty = no login) ---
ATHENA_PASSCODE=

# --- Video storage: local (default), supabase (1 GB free, no card) or r2 (10 GB free, card on file) ---
STORAGE_DRIVER=local
RETENTION_DAYS=7                 # unsaved videos are deleted after this many days
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=videos
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=athena-videos
R2_PUBLIC_URL=

# --- Free data APIs ---
FOOTBALL_DATA_KEY=               # football-data.org free tier (league tables; optional)
